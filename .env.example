# ========================================================
# JARVIS AI 2.0 Operating System — Environment Template
# ========================================================

# Host & Port
PORT=3000
NODE_ENV=production

# App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional External AI Provider Keys (System works autonomously with local neural intent parsing if keys are omitted)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Optional Database URL (Default is persistent file-backed JSON database at ./data/jarvis_db.json)
# DATABASE_URL=postgresql://user:password@localhost:5432/jarvis_db

# Web Push Notification VAPID Keys (for background mobile notifications)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PRIVATE_KEY=your_vapid_private_key
